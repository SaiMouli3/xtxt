{
  "name": "xtxt",
  "displayName": "XTXT",
  "description": "Syntax highlighting, live preview and image pasting for the XTXT document format",
  "version": "0.4.0",
  "publisher": "xtxt",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Previewing a document writes files and reads the system clipboard, so the extension stays off until the folder is trusted."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "xtxt",
        "aliases": [
          "XTXT",
          "xtxt"
        ],
        "extensions": [
          ".xtxt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xtxt",
        "scopeName": "text.xtxt",
        "path": "./syntaxes/xtxt.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.python": "python",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.shell": "shellscript"
        }
      }
    ],
    "commands": [
      {
        "command": "xtxt.showPreview",
        "title": "XTXT: Open Preview to the Side",
        "icon": "$(preview)"
      },
      {
        "command": "xtxt.pasteImage",
        "title": "XTXT: Paste Image from Clipboard"
      },
      {
        "command": "xtxt.chartTable",
        "title": "XTXT: Chart this table",
        "icon": "$(graph)"
      }
    ],
    "keybindings": [
      {
        "command": "xtxt.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == xtxt"
      },
      {
        "command": "xtxt.pasteImage",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == xtxt"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xtxt.showPreview",
          "when": "editorLangId == xtxt",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "XTXT",
      "properties": {
        "xtxt.paste.embed": {
          "type": "boolean",
          "default": false,
          "description": "Embed pasted images as data: URIs instead of saving them beside the document. Self-contained, but roughly 33% larger and it makes git diffs unreadable."
        },
        "xtxt.paste.folder": {
          "type": "string",
          "default": "",
          "description": "Folder for pasted images, relative to the document. Empty means beside the document."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SaiMouli3/xtxt.git"
  },
  "bugs": {
    "url": "https://github.com/SaiMouli3/xtxt/issues"
  },
  "homepage": "https://github.com/SaiMouli3/xtxt#readme",
  "keywords": [
    "xtxt",
    "document",
    "markdown",
    "notes",
    "format"
  ],
  "galleryBanner": {
    "color": "#151515",
    "theme": "dark"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "watch": "node esbuild.config.mjs",
    "test": "esbuild src/blocks.test.ts --bundle --platform=node --format=esm --outfile=out/blocks.test.mjs && node --test out/blocks.test.mjs",
    "vscode:prepublish": "npm run build",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "publish": "npx --yes @vscode/vsce publish --no-dependencies"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:xtxt"
  ],
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "xtxt-js": "^0.3.0"
  }
}
