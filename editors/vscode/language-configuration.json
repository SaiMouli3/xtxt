{
  "comments": { "blockComment": ["@comment\n", "\n@endcomment"] },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "`", "close": "`" },
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""], ["`", "`"], ["*", "*"]],
  "wordPattern": "[A-Za-z0-9_@-]+",
  "folding": {
    "markers": {
      "start": "^@(?!end)[A-Za-z_][A-Za-z0-9_-]*",
      "end": "^@end[A-Za-z_][A-Za-z0-9_-]*\\s*$"
    }
  }
}
