{
  "comments": { "blockComment": ["@comment\n", "\n@endcomment"] },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "`", "close": "`" },
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""], ["`", "`"], ["*", "*"]],
  "wordPattern": "[A-Za-z0-9_@-]+"
}
