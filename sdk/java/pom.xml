<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- io.github.<user> is verifiable on Maven Central without owning a
       domain, which is why the coordinates look like this. -->
  <groupId>io.github.saimouli3</groupId>
  <artifactId>xtxt</artifactId>
  <version>0.3.0</version>
  <packaging>jar</packaging>

  <name>xtxt</name>
  <description>Parser, validator and extractor for the XTXT plain-text document format</description>
  <url>https://github.com/SaiMouli3/xtxt</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>SaiMouli3</id>
      <url>https://github.com/SaiMouli3</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/SaiMouli3/xtxt</url>
    <connection>scm:git:https://github.com/SaiMouli3/xtxt.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- No runtime dependencies. Jackson is test-scoped only, because the
       conformance suite is JSON and the library itself need not speak it. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
